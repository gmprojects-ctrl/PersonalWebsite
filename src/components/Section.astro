---
// Extract the title prop passed to the Section component
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!-- Common Section component for the personal website -->
<section class="min-h-screen pt-28 pb-20 px-6">
    <div class="max-w-3xl mx-auto">
    <!-- Header -->
      <div class="mb-12">
        <h1 class="text-4xl font-bold text-white mb-3">{title}</h1>
        <div class="w-full h-1 bg-blue-500 rounded"></div>
      </div>
        <!-- Slot for section content, allowing flexible content insertion -->
      <slot />
    </div>
</section>