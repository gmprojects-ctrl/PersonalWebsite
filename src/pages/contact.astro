---
// Import the necessary components
import PageLayout from '../layouts/PageLayout.astro';
import Contact from '../components/Contact.astro';

// Import the URL constants for contact links
import { EMAIL, LINKEDIN_URL, GITHUB_URL } from '../data/constants.ts';
---
<!-- Contact information section -->
<PageLayout title="Contact Me">
<Contact
  contacts={[
    { title: 'Email me',    href: `mailto:${EMAIL}` },
    { title: 'Connect on LinkedIn', href: LINKEDIN_URL },
    { title: 'Look at my GitHub',   href: GITHUB_URL }
  ]}
  align="center"
/>
</PageLayout>