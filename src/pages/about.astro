---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title='About Me'>
  <section class="min-h-screen pt-28 pb-20 px-6">
    <div class="max-w-3xl mx-auto">

      <!-- Header -->
      <div class="mb-12">
        <h1 class="text-4xl font-bold text-white mb-3">About Me</h1>
        <div class="w-16 h-1 bg-blue-500 rounded"></div>
      </div>

      <!-- Bio -->
      <div class="mb-12 space-y-4 text-slate-300 text-lg leading-relaxed">
        <p>
          Hi, I'm <span class="text-white font-semibold">John Smith</span> — a software developer
          passionate about building clean, performant web applications. I enjoy turning complex
          problems into simple, elegant solutions.
        </p>
        <p>
          I have experience across the full stack, from crafting responsive UIs with React and
          TypeScript to designing REST APIs and managing cloud infrastructure. I care deeply about
          code quality, developer experience, and shipping things that actually work.
        </p>
        <p>
          Outside of coding I write about software on my blog, contribute to open source, and
          occasionally mentor junior developers.
        </p>
      </div>

      <!-- Skills -->
      <div class="mb-12">
        <h2 class="text-2xl font-semibold text-white mb-6">Skills</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {[
            {
              category: 'Languages',
              items: ['TypeScript', 'JavaScript', 'Python', 'SQL'],
            },
            {
              category: 'Frontend',
              items: ['React', 'Astro', 'Tailwind CSS', 'HTML & CSS'],
            },
            {
              category: 'Backend',
              items: ['Node.js', 'Express', 'PostgreSQL', 'REST APIs'],
            },
            {
              category: 'Tooling & Other',
              items: ['Git', 'Docker', 'CI/CD', 'Linux'],
            },
          ].map(({ category, items }) => (
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <h3 class="text-blue-400 font-semibold text-sm uppercase tracking-wider mb-3">
                {category}
              </h3>
              <ul class="flex flex-wrap gap-2">
                {items.map((item) => (
                  <li class="px-3 py-1 bg-slate-800 text-slate-300 text-sm rounded-full">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
