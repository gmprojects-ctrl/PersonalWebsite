        role="Short Term Trading Analyst"
        institution="Smartest Energy"
        location="London, UK"
        startYear="2024"
        endYear="Present"
        skills={["Python", "Azure", "Fabric", "Intraday Power", "Day Ahead Power", "Intraday Gas", "Day Ahead Gas"]}
        descriptions={[
            "Served as the desk analyst for the Short‐Term Power team, developing and maintaining dashboards, data systems, systematic strategies, and PowerBot algorithmic trading across GB EPEX intraday power, NBP intraday and day‐ahead gas, and GB EPEX/N2EX day‐ahead and intraday spot power auctions.",
            "Research and deploy systematic and algorithmic trading strategies for continuous intraday and auction‐based power markets, translating quantitative analysis directly into live execution alongside traders.",
            "Delivered intraday analytics for physical battery assets, informing dispatch decisions and trader positioning across short‐term GB power markets.",
            "Owned the full development lifecycle including design, deployment, and production maintenance of quantitative systems built on Python, deployed on Azure Functions, with data stored in Microsoft Fabric."
        ]}
    />
    <Experience
        role="Trading Analyst"
        institution="Smartest Energy"
        location="London, UK"
        startYear="2024"
        endYear="2025"
        skills={["Python", "Azure","Fabric", "Gas", "Power", "Emissions"]}
        descriptions={
            [
               "Delivered quantitative support to traders across UK & European Power, Gas, Carbon, and Renewables markets, designing and maintaining production-grade models, dashboards, and forecasting frameworks - including UK power stack models and European natural gas supply-demand balances.",
               "Engineered large-scale data infrastructure on Python, SQL, and Azure, processing multi-terabyte datasets and ingesting real-time feeds from Elexon, ENTSO-E, and EEX to support intra-day power trading and risk management.",
