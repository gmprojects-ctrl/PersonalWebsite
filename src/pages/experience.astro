               "Delivered dashboards, model outputs, and market analysis to traders, translating quantitative insights into actionable commercial strategies across the crude and middle distillates complex."
            ]
        }
        />
    <Experience
        role="BSc. Mathematics"
        institution="University of Warwick"
        location="Coventry, UK"
        startYear=""
        endYear=""
        skills={["Python", "C/C++","Java", "Mathematical Modelling","Machine Learning", "Data Analysis", ]}
        descriptions={
            [
              `Relevant Modules: <em>Introduction to Mathematical Statistics, Scientific Programming, Modelling and Numerics, Introduction to Machine Learning, Computational Physics, and Stochastic Processes.</em>`
            ]
        }
